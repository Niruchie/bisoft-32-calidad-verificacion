<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cr.ucenfotec.bisoft32</groupId>
  <artifactId>proyecto-pruebas</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>BISOFT-32 - Proyecto final</name>
  <description>Automatizacion de pruebas de Swag Labs con Selenium 4, JUnit 5 y Page Object Model.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <selenium.version>4.52.0</selenium.version>
    <junit.version>5.10.3</junit.version>
    <groups></groups>
    <excludedGroups>defecto</excludedGroups>
    <report.kind>execution</report.kind>
    <run.folder></run.folder>
    <runfolder></runfolder>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.aventstack</groupId>
      <artifactId>extentreports</artifactId>
      <version>5.1.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <groups>${groups}</groups>
          <excludedGroups>${excludedGroups}</excludedGroups>
          <systemPropertyVariables>
            <report.kind>${report.kind}</report.kind>
            <run.folder>${run.folder}</run.folder>
            <runfolder>${runfolder}</runfolder>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>defectos</id>
      <properties>
        <groups>defecto</groups>
        <excludedGroups></excludedGroups>
        <report.kind>defect</report.kind>
      </properties>
    </profile>
  </profiles>
</project>
